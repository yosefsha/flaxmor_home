# Copy this file to `.env` and fill in the real values. `.env` is
# git-ignored and must never be committed.
#
#   cp .env.example .env
#
# See docs/design-decisions.md for the reasoning behind the credential split
# below and the config-persistence caveat for Open WebUI.

# --- OpenAI (Upstream) -------------------------------------------------
#
# Your real OpenAI API key. Configured on the `middleware` service ONLY —
# it never enters Open WebUI's environment or database, so it cannot be
# read or replaced by anyone with admin access to the web app.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-real-openai-api-key

# The model the Middleware advertises via /v1/models and forwards every
# request to. Must be a chat-completions model the System Prompt has been
# tuned against, not a reasoning model (Open WebUI rewrites the `system`
# role those use, which this design depends on).
MODEL_ID=gpt-4o-mini

# --- Middleware <-> Open WebUI shared token -----------------------------
#
# A LOCAL shared secret, not an OpenAI key. Open WebUI sends this as its
# bearer token; the Middleware verifies it against this same value and then
# discards it — it is never forwarded upstream. This is what keeps the
# Middleware from being an open relay to a paid API once its port is
# published for local testing. Generate a random value, e.g.:
#   openssl rand -hex 32
MIDDLEWARE_API_KEY=replace-with-a-random-local-shared-token

# --- Postgres (Open WebUI's database) -----------------------------------
#
# Credentials for the `db` service. Open WebUI connects using these via
# DATABASE_URL, assembled automatically in docker-compose.yml.
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=openwebui

# --- Open WebUI ----------------------------------------------------------
#
# Signing key for Open WebUI's session cookies / auth tokens. Keep this
# stable across restarts (a value that changes invalidates existing
# sessions). Generate a random value, e.g.:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-a-random-session-signing-key

# Host port Open WebUI is published on. Visit http://localhost:<this port>
# once the stack is up.
OPEN_WEBUI_PORT=3000

# --- Middleware logging & tuning -----------------------------------------
#
# Emits full request/response message content (including the injected
# System Prompt) to the logs. Defaults to False so no document a user
# pastes (email, receipt, medical report) ends up in `docker compose logs`
# by accident. Set True only when deliberately debugging the prompt.
LOG_PROMPTS=False

# Python logging level for the Middleware.
LOG_LEVEL=INFO

# --- Middleware advanced tuning (safe to leave at these defaults) --------
#
# Base URL of the OpenAI-compatible Upstream API. Override only to point at
# a compatible proxy or a regional endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Sampling defaults applied only when the client (Open WebUI) sends none.
# temperature 0 favours format compliance; max_tokens is a floor generous
# enough for a long document's Extraction Block.
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=4096

# Timeouts (seconds) for the Middleware's connection to the Upstream.
UPSTREAM_CONNECT_TIMEOUT=5.0
UPSTREAM_READ_TIMEOUT=120.0

# How long a readiness probe result against the Upstream is cached, and the
# timeout for that probe (seconds).
READINESS_CACHE_SECONDS=30.0
READINESS_PROBE_TIMEOUT=2.0
